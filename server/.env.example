PGDATABASE=""
PGHOST=""
PGPASSWORD=""
PGPORT=
PGUSER=""
# PGSSL=false for a local PostgreSQL; leave unset for Render

# Unit 8 lab: GitHub OAuth app (GitHub > Settings > Developer settings > OAuth Apps)
# Homepage URL http://localhost:5173, callback URL http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Where GitHub sends the browser back, and where the server sends it after login.
# On Render (Unit 9 lab) these become the web service URL plus /auth/github/callback
# and the static site URL, and the same two URLs go on the GitHub OAuth app.
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
CLIENT_URL=http://localhost:5173
# Signs the session cookie; any long random string
SESSION_SECRET=""
